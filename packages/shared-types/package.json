{
  "name": "@nokkam/shared-types",
  "version": "0.0.0",
  "private": true,
  "description": "Public API contracts (DTOs, enums, request schemas) shared by web and api. No server internals.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nokkam/eslint-config": "workspace:*",
    "@nokkam/tsconfig": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "5.9.3"
  }
}
