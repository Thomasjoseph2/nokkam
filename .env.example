# ---------------------------------------------------------------------------
# Copy to .env (repo root). Both apps read from here in local development.
# Never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- API -------------------------------------------------------------------
PORT=4000
# Docker compose Mongo runs as a single-node replica set (required for transactions).
MONGODB_URI=mongodb://localhost:27018/nokkam?directConnection=true
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Set to true when served over HTTPS (production).
COOKIE_SECURE=false
LOG_LEVEL=debug
# Number of reverse proxies in front of the API (for correct client IPs / rate limiting).
TRUST_PROXY_HOPS=0

# Email: "log" prints emails to the API log, "smtp" sends via SMTP.
#   Local inbox (Mailpit, http://localhost:8025): EMAIL_TRANSPORT=smtp, SMTP_HOST=localhost, SMTP_PORT=1025
#   Real provider (Brevo, SES, Gmail app password, ...): set host/port/secure + SMTP_USER/SMTP_PASSWORD,
#   and use an EMAIL_FROM address on a domain the provider has verified.
EMAIL_TRANSPORT=log
EMAIL_FROM="Nokkam <no-reply@nokkam.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Used by `pnpm --filter @nokkam/api seed:admin`
ADMIN_EMAIL=admin@nokkam.local
ADMIN_PASSWORD=change-me-admin-password

# --- Web ---------------------------------------------------------------
# Port for `next dev` / `next start`. If you change it, update WEB_URL and CORS_ORIGINS to match.
WEB_PORT=3000

# --- Shared URLs -----------------------------------------------------------
# Public URL of the web app (used for links in emails, canonical URLs, sitemap).
WEB_URL=http://localhost:3000
# URL the Next.js server uses to reach the API (server-side fetch + /api rewrites).
API_URL=http://localhost:4000
