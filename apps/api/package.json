{
  "name": "@nokkam/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.js",
    "test:unit": "jest --config jest.config.js --selectProjects unit",
    "test:integration": "jest --config jest.config.js --selectProjects integration",
    "test:e2e": "jest --config jest.config.js --selectProjects e2e",
    "seed:admin": "nest build && node dist/scripts/seed-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.1",
    "@nokkam/shared-types": "workspace:*",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "mongoose": "8.24.5",
    "nestjs-pino": "5.3.1",
    "nodemailer": "7.0.13",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@nokkam/eslint-config": "workspace:*",
    "@nokkam/tsconfig": "workspace:*",
    "@swc/core": "1.16.13",
    "@swc/jest": "0.2.39",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.12",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "mongodb-memory-server": "10.4.3",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "typescript": "5.9.3"
  }
}
